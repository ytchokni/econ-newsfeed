# Database (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=econ_app
DB_PASSWORD=secret
DB_NAME=econ_newsfeed
# DB_SSL_CA=/path/to/ca-cert.pem  # Uncomment for managed cloud databases (RDS, Cloud SQL)
# DB_POOL_SIZE=20  # Per-process pool size (compose default 20); with 4 gunicorn workers = 80 connections

# Docker Compose only — MySQL root password
MYSQL_ROOT_PASSWORD=rootsecret


# LLM provider: Google AI Studio (required)
# Get an API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Gemini model ID. Default: Gemini 2.5 Flash.
LLM_MODEL=gemma-4-31b-it

# Scraping
# A fetch pass is due this long after the last one started; URLs fetched
# successfully within it are skipped.
SCRAPE_INTERVAL_HOURS=24
# API only: on start, resume an interrupted pass or start one that is due.
SCRAPE_ON_STARTUP=false
# Parallel fetch workers, each on a different host (per-host rate limits are
# unchanged). 6: a full pass of ~37.5k URLs takes ~3 h instead of ~17 h.
SCRAPE_CONCURRENCY=6
# true: the API schedules the fetch pass (local dev). Production runs it in the
# separate `scraper` Compose service (COMPOSE_PROFILES=...,scraper) and sets
# SCRAPE_IN_API=false, so API deploys never cut a pass off.
SCRAPE_IN_API=true
# DB pool of the scraper service (SCRAPE_CONCURRENCY + 2 is enough).
# SCRAPER_DB_POOL_SIZE=8
# User-Agent for page fetches; unset or empty keeps the built-in default.
# SCRAPER_USER_AGENT=
SCRAPE_API_KEY=changeme-min-16chars
# Optional shared secret (min 16 chars) that the Next.js server sends on its
# server-side fetches so page rendering for search-engine crawls is not
# rate limited. Set the same value on the API (this file) and on Vercel.
INTERNAL_API_KEY=
ADMIN_PASSWORD=changeme-admin-password
SCRAPE_RATE_LIMIT_SECONDS=2
# Per-host spacing for large hosts (sites.google.com, github.io, ...).
# SCRAPE_RATE_LIMIT_FAST_SECONDS=0.5
# Characters of page text per extraction call. Longer pages are split into
# chunks of this size between entries (never truncated), up to
# EXTRACTION_MAX_CHUNKS calls per page.
CONTENT_MAX_CHARS=20000
EXTRACTION_MAX_CHUNKS=12
# Download cap in bytes. Pages over 1 MB are stripped of inline CSS/SVG/
# data URIs (then scripts) and stored if the result fits in 1 MB.
FETCH_MAX_BYTES=10000000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# OpenAlex (optional — enriches papers with coauthors, abstracts)
OPENALEX_API_KEY=
OPENALEX_MAILTO=your@email.com
OPENALEX_DAILY_BUDGET=1000

# Enrichment worker (runs continuously in the API process)
ENRICHMENT_WORKER_ENABLED=false

# Extraction worker (continuous LLM extraction in the API process)
# Free-tier Gemma pacing: calls are latency-bound (45-190s); the delay only
# guards runs of small pages against the 30 RPM free-tier cap.
EXTRACTION_WORKER_ENABLED=false
EXTRACTION_DELAY_SECONDS=2
# Parallel extraction loops (calls are latency-bound). The process-wide LLM
# limiter keeps all calls under the key's per-minute caps (16k input tokens
# and 30 requests on gemma-4-31b Tier 1); extraction uses at most 80% of it.
# Set either cap to 0 to disable that limit.
EXTRACTION_CONCURRENCY=2
LLM_INPUT_TOKENS_PER_MINUTE=14000
LLM_REQUESTS_PER_MINUTE=25

# Feed events: a 'now published' item may predate its event by at most this many years
FEED_PUBLISHED_MAX_AGE_YEARS=1

# JEL field classification (scheduled in the API process; issue #271).
# Classifies tracked researchers from bio + paper titles/abstracts + OpenAlex
# topics, only when they are new, their evidence changed, or a retry is due.
# Shares the free-tier LLM key with extraction, so it has its own budget:
# at most BATCH_CALLS per run, DAILY_LIMIT per UTC day (counted in llm_usage),
# one call in flight with DELAY_SECONDS between calls (~3 RPM, ~3K TPM).
# It yields to extraction (see JEL_YIELD_* below) and stops on its own first
# quota refusal.
JEL_CLASSIFICATION_ENABLED=false
JEL_CLASSIFICATION_INTERVAL_MINUTES=60
JEL_CLASSIFICATION_BATCH_CALLS=40
JEL_CLASSIFICATION_DAILY_LIMIT=600
JEL_CLASSIFICATION_DELAY_SECONDS=20
# Researchers already classified are revisited after new papers/bio only
# once their last check is this old.
JEL_RECLASSIFY_AFTER_DAYS=30
# Yield to extraction: skip a run (and stop a running one before its next
# call) for this many minutes after extraction was refused by the provider;
# skip runs while more than JEL_MAX_EXTRACTION_BACKLOG pages wait for
# extraction (1000 = ~7-10 h at 2,500-3,400 pages/day). 0 disables a check.
JEL_YIELD_AFTER_QUOTA_MINUTES=15
JEL_MAX_EXTRACTION_BACKLOG=1000

# Paced bio backfill (issue #258): regenerates missing researcher bios from
# stored HOME page text. Shares the free-tier LLM key with extraction, so it
# is off by default and tiny: BATCH_CALLS per run, DAILY_LIMIT per UTC day,
# one call in flight with DELAY_SECONDS between calls, and a run stops on the
# first quota refusal. Like JEL it yields to extraction: no run within
# YIELD_AFTER_QUOTA_MINUTES of an extraction quota refusal, and none while more
# than MAX_BACKLOG pages wait for extraction (so it starts after the backlog clears).
# ~3,500 bios at 150/day take about 24 days.
BIO_BACKFILL_ENABLED=false
BIO_BACKFILL_INTERVAL_MINUTES=60
BIO_BACKFILL_BATCH_CALLS=10
BIO_BACKFILL_DAILY_LIMIT=150
BIO_BACKFILL_DELAY_SECONDS=30
BIO_BACKFILL_MAX_BACKLOG=50
BIO_BACKFILL_YIELD_AFTER_QUOTA_MINUTES=15

# Top-5 journal coverage shown on /about (backend/coverage/top5_job.py): weekly
# (Sundays 04:30 UTC, plus a catch-up 15 min after boot when no result is newer
# than 8 days and nothing, failed runs included, was attempted in 24 h). Compares Crossref's AER/Econometrica/JPE/QJE/REStud research
# articles since FROM_YEAR with our papers; ~30 Crossref and ~60 anonymous
# OpenAlex requests per run (OPENALEX=false skips the author-ID lookup).
# Run by hand: python -m backend.main top5-coverage [--dry-run] [--force]
TOP5_COVERAGE_ENABLED=true
TOP5_COVERAGE_FROM_YEAR=2020
TOP5_COVERAGE_OPENALEX=true

# Authentication (Google SSO via NextAuth.js)
# NEXTAUTH_SECRET must be identical on the frontend (Vercel) and the API
# (it signs the JWT the backend verifies).
NEXTAUTH_SECRET=generate-a-random-secret-here
# Local/self-hosted only. On Vercel it is ignored: sign-in uses the host the
# visitor is on, so register https://<each-host>/api/auth/callback/google as
# an authorized redirect URI in the Google OAuth client.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API scrape protection (backend/api_protection.py)
# Shared secret the frontend sends as X-Internal-Api-Key so the API can trust the
# visitor IP it forwards (min 16 chars). Set the SAME value on Vercel (frontend)
# and in the API .env. Generate with: openssl rand -hex 32
# Rollout order matters: set it on Vercel first and redeploy, then here.
# Unset here = fail open (coarser per-edge-IP limits, warning in the logs).
# Set here but not on Vercel = all site traffic arrives keyless from a few
# Vercel IPs; it only keeps working while API_DIRECT_ACCESS=open.
INTERNAL_API_KEY=
# Calls straight to the API host without the key: open (the coarse fail-open
# limits) | limited (RATE_LIMIT_*_DIRECT) | deny (403 on data endpoints;
# health, ready, feed.xml and auth keep working). Switch from open only after
# the frontend sends the key; with the key missing on Vercel, limited or deny
# rate-limits or blocks the whole site.
API_DIRECT_ACCESS=open
# Anonymous paging caps: per_page is clamped, pages past the depth get 400.
API_MAX_PER_PAGE=50
API_MAX_RESULT_DEPTH=2000
# Limits per client (slowapi syntax, ';'-separated), counted per gunicorn worker.
# "data" = publication and researcher lists and details combined.
RATE_LIMIT_DATA=60/minute;600/hour;3000/day
RATE_LIMIT_DATA_DIRECT=20/minute;200/hour;1000/day
RATE_LIMIT_DATA_USER=120/minute;3000/hour;20000/day
RATE_LIMIT_DATA_LEGACY=240/minute
RATE_LIMIT_SSR=120/minute;3000/hour
RATE_LIMIT_OPTIONS=60/minute;600/hour
RATE_LIMIT_OPTIONS_DIRECT=20/minute;200/hour

# Email digest and sign-in codes (Resend)
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@econ-newsfeed.com

# Passwordless email-code login (uses the Resend key above)
# Sender for sign-in codes; defaults to DIGEST_FROM_EMAIL. Its domain must be
# verified at Resend, e.g. "Econ Newsfeed <login@econnewsfeed.org>".
LOGIN_FROM_EMAIL=
# Deployment-wide cap on sign-in codes sent per hour.
EMAIL_LOGIN_HOURLY_LIMIT=200
# Circuit breaker: this many wrong codes in an hour (all addresses) pauses
# email sign-in and logs email_login_circuit_open for the daily monitor.
EMAIL_LOGIN_MAX_FAILURES_PER_HOUR=100
# Local dev only: with no RESEND_API_KEY and a localhost FRONTEND_URL, log
# codes to the API console instead of emailing them.
EMAIL_LOGIN_DEV_LOG_CODES=false

# Gmail inbox for working paper newsletters (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# URL Discovery (optional — Searlo web search for finding researcher websites)
# Searlo limits: 5/s, 10/min, 200/hour, 1000/day
SEARLO_API_KEY=
DISCOVERY_DAILY_LIMIT=1000
DISCOVERY_SEARCH_DELAY=18

# Cheap website mining: no search/LLM calls. Hourly cached-HTML batches plus
# weekly directory refreshes; strong name + publication evidence auto-adds URLs.
SITE_MINING_ENABLED=false
SITE_MINING_SOURCE_LIMIT=500
SITE_MINING_CANDIDATE_LIMIT=30
SITE_MINING_MAX_REQUESTS=200
SITE_MINING_MAX_SECONDS=600
# Production: COMPOSE_PROFILES=mining starts a separate worker; leave
# SITE_MINING_ENABLED=false to avoid also scheduling it inside the API.
# COMPOSE_PROFILES=mining
# With the scraper service: COMPOSE_PROFILES=mining,scraper and SCRAPE_IN_API=false.

# Production deployment
# FRONTEND_URL=https://your-app.vercel.app    # Required in prod for CORS
# WEB_CONCURRENCY=2                           # Gunicorn workers (default 2)
