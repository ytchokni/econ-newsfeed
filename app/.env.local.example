# Backend API URL (used by the frontend for data fetching)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API URL used by Next.js rewrites (next.config.mjs).
# Inside Docker this is set automatically to http://api:8000.
# When running the frontend outside Docker, set this to the backend's local address:
API_INTERNAL_URL=http://localhost:8001

# --- Search engines (all optional) ---
# Canonical origin used in <link rel="canonical">, sitemap.xml and the host
# redirect. Default: https://www.econnewsfeed.org
# SITE_URL=https://www.econnewsfeed.org
# Shared secret also set on the API (INTERNAL_API_KEY in the root .env): lets
# server-side page rendering skip the API's per-IP rate limit during crawls.
# INTERNAL_API_KEY=
# Meta-tag verification codes (only needed if you verify with a meta tag
# instead of a DNS TXT record).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
